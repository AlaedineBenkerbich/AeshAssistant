root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Composable functions are PascalCase by convention (they act like implicit
# UI factories), which otherwise trips ktlint's standard function-naming rule.
ktlint_function_naming_ignore_when_annotated_with = Composable
