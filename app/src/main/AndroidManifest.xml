<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required on API 33+ to show the daily report reminder notification
         (see fr.alaedine.aesh.data.reminder); requested at runtime by
         MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to capture a photo of a physical schedule (see
         fr.alaedine.aesh.presentation.schedule.scanner); requested at
         runtime by ScheduleScannerRoute. The photo never leaves the device:
         it's only used locally for on-device ML Kit text recognition. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The schedule scanner is an optional AI feature (see README), so the
         app must remain installable on camera-less devices. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Required to dictate observation notes (see
         fr.alaedine.aesh.presentation.report.NotesImportViewModel). Only ever
         used with Android's on-device speech recognizer: audio never leaves
         the device. Optional, like the camera. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AeshApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AESHAssistant">

        <!-- Lets the camera app save a photo of written notes into our cache
             dir (see DailyReportFormRoute); never exposes anything else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AESHAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>