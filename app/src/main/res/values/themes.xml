<resources>
    <!-- Window-level theme. The UI itself is drawn by Compose with
         AeshAssistantTheme (see presentation/theme/Theme.kt); this only styles
         what shows before and behind it: the launch window, its background
         and the system bars. Material 3 (rather than the template's Material
         Components purple/teal) keeps those in step with the Compose theme,
         and AeshApplication applies dynamic color to it on Android 12+, as
         AeshAssistantTheme does. DayNight switches to the dark palette on its
         own, so no values-night override is needed. -->
    <style name="Theme.AESHAssistant" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
